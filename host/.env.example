# Copy to .env and fill in. .env is kept out of git.

# YouTube Studio → Go live → Stream key
STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx
# Another platform instead of YouTube, e.g. Twitch:
# RTMP_URL=rtmp://live.twitch.tv/app

# The camera's H.264 RTSP stream (the URL format is in the camera manual)
CAMERA_URL=rtsp://user:password@192.168.1.60:554/stream1
# camera = stream the camera microphone, silent = silent track
STREAM_AUDIO=silent

# The CrowBox: ESP32 over WiFi (give it a fixed address in the router)
CROWBOX_PORT=socket://192.168.1.50:7777

# Timestamps in events.jsonl and snapshot names
TZ=Europe/Berlin
